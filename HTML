
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dakshina Bites - South Indian Restaurant</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Navigation -->
    <header>
        <nav class="navbar">
            <h2 class="logo">Dakshina Bites</h2>

            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#menu">Menu</a></li>
                <li><a href="#offers">Offers</a></li>
                <li><a href="#reviews">Reviews</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <div class="hero-content">
            <h1>Authentic South Indian Flavours</h1>
            <p>Delicious food, traditional taste and unforgettable moments.</p>
            <a href="#menu" class="btn">Explore Our Menu</a>
        </div>
    </section>

    <!-- Food Menu -->
    <section class="menu" id="menu">
        <h2>Our Delicious Menu</h2>
        <p class="section-description">
            Enjoy our freshly prepared South Indian specialities.
        </p>

        <div class="menu-container">

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1668236543090-82eba5ee5976?w=600"
                     alt="Masala Dosa">
                <h3>Masala Dosa</h3>
                <p>Crispy dosa with delicious potato filling.</p>
                <h4>₹90</h4>
                <button>Order Now</button>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1589301760014-d929f3979dbc?w=600"
                     alt="Idli Sambar">
                <h3>Idli & Sambar</h3>
                <p>Soft idlis served with hot sambar.</p>
                <h4>₹60</h4>
                <button>Order Now</button>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1601050690597-df0568f70950?w=600"
                     alt="Medu Vada">
                <h3>Medu Vada</h3>
                <p>Crispy and tasty South Indian vada.</p>
                <h4>₹70</h4>
                <button>Order Now</button>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1547592180-85f173990554?w=600"
                     alt="South Indian Meals">
                <h3>South Indian Meals</h3>
                <p>Traditional rice, curries and side dishes.</p>
                <h4>₹180</h4>
                <button>Order Now</button>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1567337710282-00832b415979?w=600"
                     alt="Veg Biryani">
                <h3>Veg Biryani</h3>
                <p>Delicious rice with vegetables and spices.</p>
                <h4>₹150</h4>
                <button>Order Now</button>
            </div>

            <div class="food-card">
                <img src="https://images.unsplash.com/photo-1512058564366-18510be2db19?w=600"
                     alt="Lemon Rice">
                <h3>Lemon Rice</h3>
                <p>Traditional tangy lemon rice.</p>
                <h4>₹100</h4>
                <button>Order Now</button>
            </div>

        </div>
    </section>

    <!-- Special Offers -->
    <section class="offers" id="offers">
        <h2>Special Offers</h2>

        <div class="offer-container">
            <div class="offer-card">
                <h3>20% OFF</h3>
                <p>Get 20% discount on your first order.</p>
            </div>

            <div class="offer-card">
                <h3>Family Combo</h3>
                <p>Enjoy our special family meals starting at ₹499.</p>
            </div>

            <div class="offer-card">
                <h3>Breakfast Offer</h3>
                <p>Enjoy a delicious breakfast combo for ₹99.</p>
            </div>
        </div>
    </section>

    <!-- Customer Reviews -->
    <section class="reviews" id="reviews">
        <h2>Customer Reviews</h2>

        <div class="review-container">
            <div class="review-card">
                <h3>Rahul</h3>
                <div class="stars">★★★★★</div>
                <p>"Amazing food and excellent service. Loved the dosa!"</p>
            </div>

            <div class="review-card">
                <h3>Priya</h3>
                <div class="stars">★★★★★</div>
                <p>"The food tastes just like traditional homemade food."</p>
            </div>

            <div class="review-card">
                <h3>Arjun</h3>
                <div class="stars">★★★★☆</div>
                <p>"Great atmosphere and delicious South Indian meals."</p>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact" id="contact">
        <h2>Contact Us</h2>

        <div class="contact-container">
            <div>
                <h3>Our Location</h3>
                <p>Vijayawada, Andhra Pradesh, India</p>
            </div>

            <div>
                <h3>Phone Number</h3>
                <p>+91 98765 43210</p>
            </div>

            <div>
                <h3>Email</h3>
                <p>dakshinabites@example.com</p>
            </div>

            <div>
                <h3>Opening Hours</h3>
                <p>Monday - Sunday</p>
                <p>9:00 AM - 10:00 PM</p>
            </div>
        </div>

        <iframe
            src="https://www.google.com/maps?q=Vijayawada%2C%20Andhra%20Pradesh&output=embed"
            width="100%"
            height="300"
            style="border:0;"
            loading="lazy"
            allowfullscreen>
        </iframe>
    </section>

    <!-- Footer -->
    <footer>
        <h3>Dakshina Bites</h3>
        <p>Authentic South Indian Flavours, Delivered Hot.</p>
        <p>© 2026 Dakshina Bites. All Rights Reserved.</p>
    </footer>

</body>
</html>
